// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",

	"runArgs": [
		"--gpus",
		"all"
	],

	// Run apt-get update and install the required libraries, then install Python packages
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgl1-mesa-glx libxkbcommon0 libegl1 libdbus-1-3 && pip3 install --user -r requirements.txt"

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
